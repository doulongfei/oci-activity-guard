[Unit]
Description=OCI local activity samples and business protection
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/opt/oci-activity-guard/current
ExecStart=/usr/bin/python3 -m oci_activity_guard monitor
Restart=on-failure
RestartSec=5s
StateDirectory=oci-activity-guard
StateDirectoryMode=0750
UMask=0027
Nice=10
CPUQuota=5%
MemoryMax=128M
TasksMax=24
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/oci-activity-guard
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
